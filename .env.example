# Node-RED IoT Dashboard URL
# For local development: http://127.0.0.1:1880/ui
# For production: your deployed Node-RED URL (e.g., https://your-nodered.herokuapp.com/ui)
NEXT_PUBLIC_NODERED_URL=http://127.0.0.1:1880/ui

# Google AI API Key for Genkit
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Adafruit IO (IoT Sensor Integration) ──────────────────────────────────────
# Your Adafruit IO username (visible in your Adafruit IO profile)
ADAFRUIT_IO_USERNAME=your_adafruit_username
NEXT_PUBLIC_ADAFRUIT_USERNAME=your_adafruit_username

# Your Adafruit IO API key from https://io.adafruit.com → My Key
# ADAFRUIT_IO_KEY   → used by SERVER-SIDE API routes (src/lib/adafruit-io.ts)
# NEXT_PUBLIC_ADAFRUIT_IO_KEY → used by CLIENT-SIDE gauge component (src/components/dashboard/adafruit-gauges.tsx)
# Both must be set to the same key value.
ADAFRUIT_IO_KEY=aio_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADAFRUIT_IO_KEY=aio_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the Adafruit IO base URL (default: https://io.adafruit.com/api/v2)
# ADAFRUIT_IO_BASE_URL=https://io.adafruit.com/api/v2

# Firebase Configuration (if needed as environment variables)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=